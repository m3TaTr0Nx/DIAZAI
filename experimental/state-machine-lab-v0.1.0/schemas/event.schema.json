{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://diazai.local/schemas/event.v1.json",
  "title":"DIAZAI Event Tuple v1",
  "description":"Append-only transition/event envelope E=(id,type,source,target,payload,tick,trace).",
  "type":"object",
  "required":["version","id","type","source","target","payload","tick","trace"],
  "properties": {
    "version":{"const":"1.0.0"},
    "id":{"type":"string"},
    "type":{"type":"string"},
    "source":{"type":"string"},
    "target":{"type":["string","null"]},
    "payload":{"type":"object"},
    "tick":{"type":"integer","minimum":0},
    "trace":{"type":"object","required":["trace_id","reason"],"properties":{"trace_id":{"type":"string"},"reason":{"type":"string"}}}
  },
  "additionalProperties":false
}
